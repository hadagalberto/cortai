# ---- chaves (segredos) -------------------------------------------------
# O OpenRouter resolve LLM, juiz (Jev) e transcricao. So esta e obrigatoria.
OPENROUTER_API_KEY=

# opcionais, so como reserva de ASR
GROQ_API_KEY=
OPENAI_API_KEY=

# ---- senha do painel (opcional) ---------------------------------------
# So e necessaria se for abrir o painel para a rede (--host 0.0.0.0).
# Se ficar vazio, o painel gera uma e imprime no console na primeira vez.
PANEL_PASSWORD=

# ---- ajustes pontuais (opcional) --------------------------------------
# Qualquer chave do config.json pode ser sobreposta por ambiente.
# Padrao: LIVES_<SECAO>__<CHAVE>  (dois underscores separam niveis)
#
# LIVES_RENDER__MODE=crop
# LIVES_RENDER__KARAOKE_SIZE=110
# LIVES_MOMENTS__PEAK_Z=1.7
# LIVES_CLASSIFY__MIN_SCORE=7.5
# LIVES_PUBLISH__AUTO=true
# LIVES_PUBLISH__AUTO_MIN_SCORE=8
# LIVES_ASR__KEYTERMS=GTA,Trevor,Franklin
#
# O que estiver aqui vence o config.json (e o painel nao consegue sobrescrever).
