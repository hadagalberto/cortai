{
  "work_dir": "work",
  "out_dir": "out",
  "live": {
    "buffer_seconds": 600,
    "window_s": 60,
    "cycle_s": 20,
    "min_buffer_s": 75,
    "quality": "best",
    "chat_enabled": true,
    "max_streams": 5
  },
  "moments": {
    "top_n": 10,
    "min_sep_s": 45,
    "peak_z": 1.3,
    "pre_roll_s": 10,
    "post_roll_s": 20,
    "context_pre_s": 12,
    "context_post_s": 25,
    "min_clip_s": 10,
    "max_clip_s": 37,
    "weights": {
      "loudness": 1,
      "flux": 0.7,
      "chat": 1.3
    }
  },
  "asr": {
    "language": "pt",
    "chain": [
      "openrouter",
      "groq",
      "openai",
      "local"
    ],
    "local_model": "small",
    "keyterms": [
      "GTA",
      "GTA V",
      "GTA 6",
      "Los Santos",
      "Trevor",
      "Franklin",
      "Michael",
      "CJ"
    ],
    "models": {
      "openrouter": "elevenlabs/scribe-v2",
      "groq": "whisper-large-v3-turbo",
      "openai": "whisper-1"
    }
  },
  "llm": {
    "cooldown_s": 180,
    "providers": [
      {
        "name": "glm-flash",
        "kind": "openai",
        "base_url": "https://openrouter.ai/api/v1",
        "model": "z-ai/glm-5.3-flash",
        "key_env": "OPENROUTER_API_KEY"
      },
      {
        "name": "haiku",
        "kind": "openai",
        "base_url": "https://openrouter.ai/api/v1",
        "model": "anthropic/claude-haiku-5.5",
        "key_env": "OPENROUTER_API_KEY"
      }
    ]
  },
  "classify": {
    "min_score": 7.0,
    "frames": 6,
    "mode": "cascade",
    "jev": {
      "enabled": true,
      "model": "typesafe/jev-1.14",
      "min_score": 5.5,
      "min_event": 0.5
    },
    "copy_frames": 3
  },
  "pricing": {
    "asr": {
      "openrouter": 0.0037,
      "openai": 0.006,
      "groq": 0.0004,
      "local": 0
    },
    "llm": {
      "google/gemini-2.5-flash": {
        "in": 0.3,
        "out": 2.5
      },
      "anthropic/claude-sonnet-4.5": {
        "in": 3,
        "out": 15
      },
      "openai/gpt-5-mini": {
        "in": 0.25,
        "out": 2
      },
      "default": {
        "in": 0.5,
        "out": 2
      },
      "z-ai/glm-5.3-flash": {
        "in": 0.04,
        "out": 0.078
      },
      "anthropic/claude-haiku-5.5": {
        "in": 0.1,
        "out": 0.5
      }
    },
    "brl_per_usd": 5.4
  },
  "facecam": {
    "enabled": true,
    "provider": "jev",
    "refresh_s": 900,
    "samples": 20,
    "jev_samples": 3,
    "min_confidence": 0.12,
    "pad": 3.4,
    "min_frame_hits": 0.3
  },
  "render": {
    "mode": "pad_blur",
    "focus_x": 0.5,
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "crf": 20,
    "preset": "veryfast",
    "audio_bitrate": "192k",
    "burn_subs": true,
    "hook_caption": true,
    "sub_size": 76,
    "karaoke_size": 96,
    "karaoke_words": 3,
    "karaoke_margin_v": 300,
    "hook_size": 92,
    "sub_margin_v": 300,
    "blur_sigma": 22.0,
    "pip_scale": 0.37,
    "pip_position": "tr",
    "pip_offset_y": 400.0,
    "pip_margin": 44,
    "pip_border": 8
  },
  "publish": {
    "auto": false,
    "auto_min_score": 7.5,
    "privacy": "public",
    "category_id": "20",
    "description_footer": "",
    "schedule_hours": [],
    "max_attempts": 5,
    "retry_minutes": 5,
    "max_per_day": 0,
    "min_gap_minutes": 90
  },
  "maintenance": {
    "enabled": true,
    "clip_retention_days": 30,
    "keep_unpublished_days": 0,
    "db_retention_days": 90,
    "run_every_hours": 6
  },
  "templates": {
    "default": {}
  },
  "branding": {
    "logo": "branding/logo.png",
    "logo_width": 220,
    "logo_position": "tr",
    "handle": "@hadagalbertogames",
    "cta": "SEGUE PRA MAIS",
